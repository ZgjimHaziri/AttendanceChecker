PORT=3000
NODE_ENV=development

# Session signing secret — generate a long random string for any real use
SESSION_SECRET=change-me-to-a-long-random-string

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pd

# Public URL used by the browser for Socket.IO (no trailing slash)
APP_URL=http://localhost:3000
